---
import { site, type Lang } from "../content/site";
import { localePath, otherLang } from "../lib/i18n";

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = site[lang];
const other = otherLang(lang);

const navLinks = [
  { label: t.nav.home, href: localePath(lang, "/") },
  { label: t.nav.about, href: localePath(lang, "/sobre") },
  { label: t.nav.projects, href: localePath(lang, "/projetos") },
];

const langHref = localePath(other, path);
---

<header class="site-header" data-header>
  <div class="site-header__bar container">
    <a href={localePath(lang, "/")} class="site-header__logo">GABRIEL</a>

    <button
      type="button"
      class="menu-toggle"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="site-header__nav">
      <ul class="site-header__links">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.href === path ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="lang-toggle" role="group" aria-label="Language">
        {
          lang === "pt" ? (
            <span class="lang-toggle__option is-active">PT</span>
          ) : (
            <a href={langHref} class="lang-toggle__option">
              PT
            </a>
          )
        }
        <span class="lang-toggle__divider" aria-hidden="true"></span>
        {
          lang === "en" ? (
            <span class="lang-toggle__option is-active">EN</span>
          ) : (
            <a href={langHref} class="lang-toggle__option">
              EN
            </a>
          )
        }
      </div>
    </div>
  </div>

  <nav id="site-nav" class="site-nav" data-nav>
    <ul>
      {
        navLinks.map((link, i) => (
          <li style={`--i:${i}`}>
            <a
              href={link.href}
              aria-current={link.href === path ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div
      class="lang-toggle lang-toggle--mobile"
      style={`--i:${navLinks.length}`}
      role="group"
      aria-label="Language"
    >
      {
        lang === "pt" ? (
          <span class="lang-toggle__option is-active">PT</span>
        ) : (
          <a href={langHref} class="lang-toggle__option">
            PT
          </a>
        )
      }
      <span class="lang-toggle__divider" aria-hidden="true"></span>
      {
        lang === "en" ? (
          <span class="lang-toggle__option is-active">EN</span>
        ) : (
          <a href={langHref} class="lang-toggle__option">
            EN
          </a>
        )
      }
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
    background: rgba(240, 240, 240, 0);
    border-bottom: 1px solid transparent;
    transition:
      background 0.35s ease,
      backdrop-filter 0.35s ease,
      border-color 0.35s ease;
  }

  .site-header.is-scrolled .site-header__bar {
    background: rgba(240, 240, 240, 0.85);
    backdrop-filter: blur(10px);
    border-bottom-color: rgba(18, 18, 18, 0.08);
  }

  .site-header__logo {
    font-family: var(--font-hero);
    font-weight: 400;
    font-size: 1.4rem;
    letter-spacing: 0.02em;
    color: var(--color-orange);
  }

  .menu-toggle {
    position: relative;
    z-index: 70;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 8px;
    background: none;
    border: none;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }

  body.nav-open .menu-toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  body.nav-open .menu-toggle span:nth-child(2) {
    opacity: 0;
  }

  body.nav-open .menu-toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: 28px;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .site-header__links a {
    color: rgba(18, 18, 18, 0.65);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    font-weight: 600;
    border-bottom: 2px solid transparent;
    padding-bottom: 4px;
    transition:
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .site-header__links a:hover,
  .site-header__links a[aria-current="page"] {
    color: var(--color-orange);
    border-bottom-color: var(--color-orange);
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(18, 18, 18, 0.05);
    border: 1px solid rgba(18, 18, 18, 0.16);
    border-radius: 100px;
    padding: 6px 12px;
  }

  .lang-toggle__option {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(18, 18, 18, 0.35);
    transition: color 0.2s ease;
  }

  a.lang-toggle__option:hover {
    color: var(--color-orange);
  }

  .lang-toggle__option.is-active {
    color: var(--color-ink);
  }

  .lang-toggle__divider {
    width: 1px;
    height: 10px;
    background: rgba(18, 18, 18, 0.25);
  }

  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }

    .site-header__nav {
      display: flex;
    }
  }

  .site-nav {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 36px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .site-nav.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .site-nav ul {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .site-nav li,
  .site-nav .lang-toggle--mobile {
    opacity: 0;
  }

  .site-nav.is-open li,
  .site-nav.is-open .lang-toggle--mobile {
    animation: menu-item-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 0.06s + 0.08s);
  }

  .site-nav a {
    display: inline-block;
    font-family: var(--font-hero);
    font-weight: 400;
    font-size: clamp(2rem, 8vw, 2.75rem);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .site-nav a[aria-current="page"],
  .site-nav a:hover {
    color: var(--color-orange);
  }

  .lang-toggle--mobile {
    padding: 10px 18px;
    background: var(--color-white);
  }

  .lang-toggle--mobile .lang-toggle__option {
    font-size: 0.8rem;
  }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav.is-open li,
    .site-nav.is-open .lang-toggle--mobile {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
