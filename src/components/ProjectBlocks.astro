---
import type { ProjectBlock } from "../content/projects";

interface Props {
  blocks: ProjectBlock[];
}

const { blocks } = Astro.props;
---

<div class="project-blocks">
  {
    blocks.map((block) => {
      if (block.type === "paragraph") {
        return <p data-reveal>{block.text}</p>;
      }
      if (block.type === "link") {
        return (
          <p data-reveal>
            <a
              href={block.href}
              target="_blank"
              rel="noreferrer"
              class="project-blocks__link"
            >
              {block.text}
            </a>
          </p>
        );
      }
      return (
        <figure data-reveal>
          <img src={block.src} alt={block.alt} loading="lazy" />
          {block.caption && <figcaption>{block.caption}</figcaption>}
        </figure>
      );
    })
  }
</div>

<style>
  .project-blocks {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 68ch;
    margin-top: 48px;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .project-blocks figure {
    max-width: none;
    margin: 0;
  }

  .project-blocks img {
    width: 100%;
    border-radius: 12px;
  }

  .project-blocks figcaption {
    margin-top: 12px;
    font-size: 0.9rem;
    color: var(--color-ink-50);
  }

  .project-blocks__link {
    color: var(--color-orange);
    text-decoration: underline;
  }
</style>
