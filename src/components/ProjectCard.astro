---
interface Props {
  name: string;
  href: string;
  cover: string;
}

const { name, href, cover } = Astro.props;
---

<a href={href} class="project-card" data-reveal>
  <img src={cover} alt="" aria-hidden="true" loading="lazy" />
  <span class="project-card__name">{name}</span>
</a>

<style>
  .project-card {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 260px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-ink);
  }

  .project-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .project-card:hover img {
    transform: scale(1.04);
    opacity: 0.7;
  }

  .project-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65), transparent 60%);
  }

  .project-card__name {
    position: relative;
    z-index: 1;
    padding: 24px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    color: var(--color-white);
  }
</style>
