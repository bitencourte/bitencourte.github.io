---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectMeta from "../components/ProjectMeta.astro";
import ProjectBlocks from "../components/ProjectBlocks.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site, type Lang } from "../content/site";
import { projects, type Project } from "../content/projects";
import { localePath } from "../lib/i18n";

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const t = site[lang];
const otherProjects = projects[lang].filter((p) => p.slug !== project.slug);
---

<BaseLayout lang={lang} path={`/projetos/${project.slug}`}>
  <article class="section">
    <div class="container">
      <h1 class="project-detail__title" data-reveal>{project.name}</h1>

      <ProjectMeta meta={project.meta} labels={t.projectDetail} />

      <p class="project-detail__summary" data-reveal>{project.summary}</p>

      <ProjectBlocks blocks={project.blocks} />
    </div>
  </article>

  <section class="section other-projects">
    <div class="container">
      <p class="eyebrow" data-reveal>{t.projectDetail.otherProjects}</p>
      <div class="projects-grid">
        {
          otherProjects.map((p) => (
            <ProjectCard
              name={p.name}
              cover={p.cover}
              href={localePath(lang, `/projetos/${p.slug}`)}
            />
          ))
        }
      </div>
      <a class="view-all" href={localePath(lang, "/projetos")} data-reveal
        >{t.projectDetail.viewAll}</a
      >
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 64px 0;
  }

  .project-detail__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    color: var(--color-orange);
  }

  .project-detail__summary {
    max-width: 68ch;
    margin-top: 32px;
    font-size: 1.25rem;
    line-height: 1.7;
  }

  .other-projects {
    border-top: 1px solid rgba(18, 18, 18, 0.1);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 24px;
  }

  @media (min-width: 720px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .view-all {
    display: inline-block;
    margin-top: 32px;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-ink);
  }

  .view-all:hover {
    color: var(--color-orange);
  }
</style>
