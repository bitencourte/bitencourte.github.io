---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TimelineItem from "../components/TimelineItem.astro";
import { site, type Lang } from "../content/site";
import { projects } from "../content/projects";
import { localePath } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = site[lang];
const projectList = projects[lang];
---

<BaseLayout lang={lang} path="/" title={t.nav.home}>
  <section id="hero" class="hero" data-hero>
    <div class="container hero__inner">
      <div class="hero__stage">
        <h1 class="hero__title">
          <span class="hero__word hero__word--1">{t.hero.name1}</span>
          <span class="hero__word hero__word--2">{t.hero.name2}</span>
        </h1>

        <img
          class="hero__photo"
          src="/images/profile.png"
          alt="Gabriel Bitencourte"
          data-hero-photo
        />
      </div>

      <p class="hero__subtitle">{t.hero.subtitle}</p>

      <a href="#sobre" class="hero__cta">
        {t.hero.cta} <span aria-hidden="true">&#8595;</span>
      </a>
    </div>
  </section>

  <section id="sobre" class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{t.about.eyebrow}</p>
      <div class="about__paragraphs">
        {t.about.paragraphs.map((p) => <p data-reveal>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="projetos" class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{t.projectsPreview.eyebrow}</p>
      <div class="projects-grid">
        {
          projectList.map((project) => (
            <ProjectCard
              name={project.name}
              cover={project.cover}
              href={localePath(lang, `/projetos/${project.slug}`)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{t.experience.eyebrow}</p>
      <div class="timeline">
        {
          t.experience.items.map((item) => (
            <TimelineItem heading={item.company} period={item.period} subtitle={item.role} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{t.education.eyebrow}</p>
      <div class="timeline">
        {
          t.education.items.map((item) => (
            <TimelineItem heading={item.degree} period={item.period} subtitle={item.institution} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 48px 0 40px;
    min-height: 72vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .hero {
      padding: 64px 0 56px;
      min-height: 82vh;
    }
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .hero__stage {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__word {
    font-family: var(--font-hero);
    font-weight: 400;
    font-size: min(15vw, 168px);
    line-height: 0.92;
    color: var(--color-orange);
    letter-spacing: 0.01em;
  }

  .hero__word--1 {
    animation: hero-in-left 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }

  .hero__word--2 {
    animation: hero-in-right 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  @keyframes hero-in-left {
    from {
      transform: translateX(-14%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes hero-in-right {
    from {
      transform: translateX(14%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  .hero__photo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(120px, 18vw, 198px);
    transform: translate(-50%, -50%);
    animation: hero-photo-in 1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes hero-photo-in {
    from {
      transform: translate(-50%, -46%) scale(0.85);
      opacity: 0;
    }
    to {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
  }

  .hero__subtitle {
    max-width: 36ch;
    margin-top: 40px;
    font-size: clamp(1rem, 2.2vw, 1.125rem);
    line-height: 1.6;
    color: rgba(18, 18, 18, 0.78);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    padding: 14px 30px;
    border-radius: 100px;
    background: var(--color-orange);
    color: var(--color-white);
    font-family: var(--font-accent);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    transition: opacity 0.2s ease;
  }

  .hero__cta:hover {
    opacity: 0.88;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word,
    .hero__photo {
      animation: none;
      opacity: 1;
    }
  }

  .section {
    padding: 64px 0;
  }

  .about__paragraphs {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 68ch;
    margin-top: 24px;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 24px;
  }

  @media (min-width: 720px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .timeline {
    margin-top: 24px;
  }
</style>
