---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TimelineItem from "../components/TimelineItem.astro";
import { site, type Lang } from "../content/site";
import { projects } from "../content/projects";
import { localePath } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = site[lang];
const projectList = projects[lang];

function splitLetters(word: string) {
  return [...word];
}
---

<BaseLayout lang={lang} path="/" title={t.nav.home}>
  <section class="hero">
    <div class="container hero__inner">
      <img class="hero__photo" src="/images/profile.png" alt="Gabriel Bitencourte" />
      <h1 class="hero__title">
        <span class="hero__line">
          {splitLetters(t.hero.name1).map((letter, i) => (
            <span class="letter" style={`--i:${i}`}>{letter}</span>
          ))}
        </span>
        <span class="hero__line">
          {splitLetters(t.hero.name2).map((letter, i) => (
            <span class="letter" style={`--i:${i + t.hero.name1.length}`}>{letter}</span>
          ))}
        </span>
      </h1>

      <span class="hero__spark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28">
          <path
            d="M12 0c0 6-2 8-8 8 6 0 8 2 8 8 0-6 2-8 8-8-6 0-8-2-8-8z"
            fill="var(--color-ink)"
          />
        </svg>
      </span>

      <p class="hero__subtitle">{t.hero.subtitle}</p>

      <a href="#sobre" class="hero__cta">
        <span class="hero__cta-bar" aria-hidden="true"></span>
        {t.hero.cta}
      </a>
    </div>
  </section>

  <section id="sobre" class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{t.about.eyebrow}</p>
      <div class="about__paragraphs">
        {t.about.paragraphs.map((p) => <p data-reveal>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="projetos" class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{t.projectsPreview.eyebrow}</p>
      <div class="projects-grid">
        {
          projectList.map((project) => (
            <ProjectCard
              name={project.name}
              cover={project.cover}
              href={localePath(lang, `/projetos/${project.slug}`)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{t.experience.eyebrow}</p>
      <div class="timeline">
        {
          t.experience.items.map((item) => (
            <TimelineItem heading={item.company} period={item.period} subtitle={item.role} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-reveal>{t.education.eyebrow}</p>
      <div class="timeline">
        {
          t.education.items.map((item) => (
            <TimelineItem heading={item.degree} period={item.period} subtitle={item.institution} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 64px 0 96px;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__photo {
    width: clamp(120px, 22vw, 220px);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 999px 999px 40px 40px;
    margin-bottom: -32px;
    position: relative;
    z-index: 1;
  }

  .hero__title {
    font-size: clamp(3.5rem, 13vw, 9rem);
    line-height: 0.95;
    color: var(--color-orange);
  }

  .hero__line {
    display: block;
  }

  .letter {
    display: inline-block;
    opacity: 0;
    animation: letter-in 0.6s ease forwards;
    animation-delay: calc(var(--i) * 0.035s);
  }

  @keyframes letter-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__spark {
    display: block;
    margin: 24px 0;
  }

  .hero__subtitle {
    max-width: 32ch;
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
  }

  .hero__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 56px;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.08em;
    font-size: 0.9rem;
    color: var(--color-ink-50);
  }

  .hero__cta-bar {
    width: 2px;
    height: 40px;
    background: linear-gradient(var(--color-orange), var(--color-ink-50));
  }

  .section {
    padding: 64px 0;
  }

  .about__paragraphs {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 68ch;
    margin-top: 24px;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 24px;
  }

  @media (min-width: 720px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .timeline {
    margin-top: 24px;
  }
</style>
